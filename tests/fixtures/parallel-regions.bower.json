{
  "schema": "bowerbird/v1",
  "meta": { "title": "Parallel recovery", "grid": { "col": 320, "row": 210, "gap": 90 }, "view": "flat" },
  "zones": [
    { "id": "recovery", "title": "Recovery" },
    { "id": "intake", "title": "Intake", "parent": "recovery", "parallel": true },
    { "id": "repair", "title": "Repair", "parent": "recovery", "parallel": true }
  ],
  "nodes": [
    { "id": "receive", "title": "Receive", "zone": "intake", "at": [0, 0] },
    { "id": "retry", "title": "Retry", "zone": "repair", "at": [3, 0] },
    { "id": "escalate", "title": "Escalate", "zone": "repair", "at": [3, 2] }
  ],
  "edges": [
    { "id": "act-retry", "from": "receive", "to": "retry", "kind": "failure", "event": "timeout", "guard": "retry allowed", "action": "retry" },
    { "id": "act-escalate", "from": "receive", "to": "escalate", "kind": "failure", "event": "retries exhausted", "guard": "retry denied", "action": "escalate" }
  ]
}
